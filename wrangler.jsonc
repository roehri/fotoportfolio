// Cloudflare Workers: liefert den Ordner dist/ als statische Website aus.
// Vor jedem Hochladen baut Wrangler die Seiten selbst mit „node bauen.mjs“ (unabhängig vom Dashboard).
{
  "name": "martinroehr-fotos",
  "compatibility_date": "2025-10-01",
  "build": { "command": "node bauen.mjs" },
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",   // /about liefert about.html, /de/ liefert de/index.html
    "not_found_handling": "404-page"          // unbekannte Adressen zeigen 404.html
  }
}
